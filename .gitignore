# Source videos kept locally for re-encoding — the site serves the compressed
# versions (hero-light.mp4, hero-dark.mp4, loginvideo.mp4). Committing these
# would add ~29 MB the site never loads.
videos/*.source.mp4

# Unused capture that predates the renamed assets
videos/hf_*.mp4

# Local preview config: points at a dev server on port 8123 that only exists
# on this machine.
.claude/

# npm install for @supabase/supabase-js. The browser code imports Supabase
# from the esm.sh CDN, so nothing here is used at runtime — it would just add
# thousands of files to the repo.
node_modules/

# Supabase CLI scratch: link state and a cached access token. The token is a
# credential — it must never end up in a public repo.
supabase/.temp/
supabase/.branches/

# Stripe and Supabase secrets. Nothing in this repo reads a .env at runtime;
# this line exists so a stray one can never be committed by accident.
.env
.env.*
!.env.example

# OS noise
Thumbs.db
desktop.ini
.DS_Store
